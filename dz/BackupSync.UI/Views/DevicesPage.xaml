<Page
    x:Name="MyDevicesPage"
    x:Class="BackupSync.UI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BackupSync.Core.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <StackPanel Spacing="16">

            <TextBlock Text="Управление устройствами" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="Здесь отображаются все сохраненные и подключенные сейчас USB-накопители." 
                       Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6"/>

            <ListView ItemsSource="{Binding Devices}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeviceStatus">
                        <Grid Padding="0,12" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE88E;" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.6">
                                    <TextBlock Text="Буква:"/>
                                    <TextBlock Text="{Binding Letter}" FontWeight="SemiBold"/>
                                    <TextBlock Text="|"/>
                                    <TextBlock Text="S/N:"/>
                                    <TextBlock Text="{Binding VolumeSerialNumber}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,24,0" Orientation="Horizontal" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsConnected, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE930;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Text="Подключен" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE9CE;" FontSize="12" Opacity="0.5"/>
                                    <TextBlock Text="Отключен" Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">

                                <Button Content="Сохранить" 
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Visibility="{x:Bind IsRecognized, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        Click="AddDeviceButton_Click" 
                                        Tag="{Binding}"/>

                                <Button Content="Найти диск..."
                                        Visibility="{x:Bind CanBeReAssociated, Mode=OneWay}"
                                        IsEnabled="{Binding DataContext.HasUnrecognizedDisks, ElementName=MyDevicesPage}"
                                        Click="ReAssociateButton_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Связать этот профиль с новым физическим диском"/>

                                <Button Content="Удалить"
                                        Visibility="{x:Bind IsRecognized, Mode=OneWay}" 
                                        Command="{Binding DataContext.ForgetDeviceCommand, ElementName=MyDevicesPage}"
                                        CommandParameter="{Binding}">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FF0000"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Red"/>
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Red"/>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</Page>
