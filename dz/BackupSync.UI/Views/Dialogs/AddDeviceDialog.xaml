<ContentDialog
    x:Class="BackupSync.UI.Views.Dialogs.AddDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Добавить устройство"
    PrimaryButtonText="Сохранить"
    CloseButtonText="Отмена"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="350">

        <TextBlock Text="Придумайте понятное имя для этого устройства, чтобы легко узнавать его в будущем:" 
                   TextWrapping="Wrap" 
                   Style="{ThemeResource BodyTextBlockStyle}"/>

        <TextBox x:Name="NameTextBox" 
                 Header="Название"
                 PlaceholderText="Например: Рабочая флешка"/>

    </StackPanel>
</ContentDialog>
