<Page
    x:Name="MyJobsPage"
    x:Class="BackupSync.UI.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BackupSync.Core.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Задания синхронизации" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="Настройте, какие папки и куда нужно копировать." 
                       Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="CreateJobButton" 
                    Click="CreateJobButton_Click"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;"/>
                    <TextBlock Text="Создать новое задание"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ListView Grid.Row="2" 
                  ItemsSource="{Binding Jobs}"
                  SelectionMode="None">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SyncJob">
                    <Grid HorizontalAlignment="Stretch" Padding="0,12" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding JobName}" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                            <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.7">
                                <TextBlock Text="{Binding SourcePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                <FontIcon Glyph="&#xE72A;" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Device.UserGivenName}" FontWeight="SemiBold"/>
                                <TextBlock Text="\"/>
                                <TextBlock Text="{Binding DestPath}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">

                            <Button ToolTipService.ToolTip="Начать синхронизацию"
                                    Command="{Binding DataContext.SyncJobCommand, ElementName=MyJobsPage}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Text="Старт"/>
                                </StackPanel>
                            </Button>

                            <Button ToolTipService.ToolTip="Удалить задание"
                                    Command="{Binding DataContext.DeleteJobCommand, ElementName=MyJobsPage}"
                                    CommandParameter="{Binding}">
                                <FontIcon Glyph="&#xE74D;"/>
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Red"/>
                                    </ResourceDictionary>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
